generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model activities {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id        BigInt    @db.UnsignedBigInt
  activity       String    @db.Text
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)
  activable_type String?   @db.VarChar(255)
  activable_id   BigInt?   @db.UnsignedBigInt
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "activities_user_id_foreign")

  @@index([activable_type, activable_id], map: "activities_activable_type_activable_id_index")
  @@index([user_id], map: "activities_user_id_foreign")
}

model ai_results {
  id                        Int    @id
  city                      String @db.VarChar(4)
  location_type             String @db.VarChar(16)
  daily_views_estimate      Int
  monthly_views_estimate    Int
  target_audience           String @db.VarChar(48)
  advertising_strategy      String @db.VarChar(147)
  importance_level          String @db.VarChar(27)
  characteristics           String @db.VarChar(126)
  best_times                String @db.VarChar(97)
  target_audience_text      String @db.VarChar(38)
  advertising_strategy_text String @db.VarChar(139)
  characteristics_text      String @db.VarChar(119)
  best_times_text           String @db.VarChar(91)
  vehicles_per_hour         Int
  vehicles_per_day          Int
  view_rate_per_vehicle     String @db.VarChar(18)
  time_distribution         String @db.VarChar(207)
  detailed_demographics     String @db.VarChar(238)
  advertising_value         String @db.VarChar(68)
  recommended_ad_types      String @db.VarChar(175)
  competition_analysis      String @db.VarChar(108)
}

model booking_road_sign {
  id                        BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  booking_id                BigInt     @db.UnsignedBigInt
  road_sign_id              BigInt     @db.UnsignedBigInt
  face_price                Float      @db.Float
  booking_faces             Int        @db.UnsignedInt
  total_faces_price         Float      @db.Float
  start_date                DateTime   @db.Date
  end_date                  DateTime   @db.Date
  created_at                DateTime?  @db.Timestamp(0)
  updated_at                DateTime?  @db.Timestamp(0)
  number_of_reserved_panels Int        @default(1) @db.UnsignedInt
  days_of_reservation       Int        @db.UnsignedInt
  units                     Int        @db.UnsignedInt
  is_archived               Boolean    @default(false)
  bookings                  bookings   @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "booking_road_sign_booking_id_foreign")
  road_signs                road_signs @relation(fields: [road_sign_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "booking_road_sign_road_sign_id_foreign")

  @@index([booking_id], map: "booking_road_sign_booking_id_foreign")
  @@index([road_sign_id], map: "booking_road_sign_road_sign_id_foreign")
}

model bookings {
  id                                                                           BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  user_id                                                                      BigInt?             @db.UnsignedBigInt
  customer_id                                                                  BigInt              @db.UnsignedBigInt
  parent_booking_id                                                            BigInt?             @db.UnsignedBigInt
  type                                                                         Int                 @db.UnsignedTinyInt
  start_date                                                                   DateTime            @db.Date
  end_date                                                                     DateTime            @db.Date
  total_advertising_space                                                      Float?              @db.Float
  total_printing_space                                                         Float?              @db.Float
  total_price                                                                  Float?              @db.Float
  added_price                                                                  Decimal             @default(0.00) @db.Decimal(10, 2)
  number                                                                       Int?
  product_type                                                                 Int?                @db.UnsignedInt
  notes                                                                        String?             @db.LongText
  discount_type                                                                Int?                @db.UnsignedTinyInt
  value                                                                        Float?              @db.Float
  created_at                                                                   DateTime?           @db.Timestamp(0)
  updated_at                                                                   DateTime?           @db.Timestamp(0)
  total_price_per_month                                                        Float?              @db.Float
  total_price_befor_discount                                                   Float?              @db.Float
  units                                                                        Int?                @db.UnsignedInt
  status                                                                       Int                 @default(1) @db.UnsignedTinyInt
  broker_id                                                                    Int?
  approvement_status                                                           Int                 @default(2)
  reject_reason                                                                String?             @db.VarChar(255)
  remaining                                                                    Float?              @db.Float
  printing_id                                                                  Int?
  is_archived                                                                  Boolean             @default(false)
  printing_price                                                               Float               @default(0) @db.Float
  journal_entry_id                                                             BigInt?             @db.UnsignedBigInt
  broker_commission_journal_entry_id                                           BigInt?             @db.UnsignedBigInt
  booking_road_sign                                                            booking_road_sign[]
  journal_entries_bookings_broker_commission_journal_entry_idTojournal_entries journal_entries?    @relation("bookings_broker_commission_journal_entry_idTojournal_entries", fields: [broker_commission_journal_entry_id], references: [id], onUpdate: Restrict, map: "bookings_broker_commission_journal_entry_id_foreign")
  customers                                                                    customers           @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "bookings_customer_id_foreign")
  journal_entries_bookings_journal_entry_idTojournal_entries                   journal_entries?    @relation("bookings_journal_entry_idTojournal_entries", fields: [journal_entry_id], references: [id], onUpdate: Restrict, map: "bookings_journal_entry_id_foreign")
  bookings                                                                     bookings?           @relation("bookingsTobookings", fields: [parent_booking_id], references: [id], onUpdate: Restrict, map: "bookings_parent_booking_id_foreign")
  other_bookings                                                               bookings[]          @relation("bookingsTobookings")
  users                                                                        users?              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "bookings_user_id_foreign")
  defferd_bokings                                                              defferd_bokings[]
  orders_orders_booking_idTobookings                                           orders[]            @relation("orders_booking_idTobookings")
  orders_orders_booking_new_idTobookings                                       orders[]            @relation("orders_booking_new_idTobookings")

  @@index([customer_id], map: "bookings_customer_id_foreign")
  @@index([user_id], map: "bookings_user_id_foreign")
  @@index([broker_commission_journal_entry_id], map: "bookings_broker_commission_journal_entry_id_foreign")
  @@index([journal_entry_id], map: "bookings_journal_entry_id_foreign")
  @@index([parent_booking_id], map: "bookings_parent_booking_id_foreign")
}

model broker_activities {
  id                    BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  actor_id              BigInt    @db.UnsignedBigInt
  activity_type         String    @db.VarChar(255)
  activity_data         String?   @db.LongText
  customer_informations String?   @db.LongText
  created_at            DateTime? @db.Timestamp(0)
  updated_at            DateTime? @db.Timestamp(0)
  users                 users     @relation(fields: [actor_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "broker_activities_actor_id_foreign")

  @@index([actor_id], map: "broker_activities_actor_id_foreign")
}

model brokers {
  id           BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  username     String      @db.VarChar(255)
  email        String      @db.VarChar(255)
  password     String      @db.VarChar(500)
  phone_number String      @db.VarChar(50)
  discount     Decimal     @db.Decimal(10, 0)
  created_at   DateTime?   @db.Timestamp(0)
  updated_at   DateTime?   @db.Timestamp(0)
  contracts    contracts[]
}

model cache {
  key        String @id @db.VarChar(255)
  value      String @db.MediumText
  expiration Int
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int
}

model cities {
  id         BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  name       String       @db.VarChar(255)
  is_active  Boolean      @default(true)
  created_at DateTime?    @db.Timestamp(0)
  updated_at DateTime?    @db.Timestamp(0)
  regions    regions[]
  road_signs road_signs[]
}

model companies {
  id                             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name                           String    @db.VarChar(255)
  commercial_registration_number BigInt    @unique(map: "companies_commercial_registration_number_unique") @db.UnsignedBigInt
  address                        String?   @db.VarChar(255)
  description                    String?   @db.LongText
  about_us                       String?   @db.LongText
  contract_note                  String?   @db.LongText
  created_at                     DateTime? @db.Timestamp(0)
  updated_at                     DateTime? @db.Timestamp(0)
  users                          users[]
}

model contracts {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name        String    @db.VarChar(255)
  broker_id   BigInt    @db.UnsignedBigInt
  user_id     BigInt    @db.UnsignedBigInt
  customer_id BigInt    @db.UnsignedBigInt
  start_date  DateTime  @db.Date
  end_date    DateTime  @db.Date
  type        Int       @db.UnsignedTinyInt
  status      Int       @db.UnsignedTinyInt
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  brokers     brokers   @relation(fields: [broker_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "contracts_broker_id_foreign")
  customers   customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "contracts_customer_id_foreign")
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "contracts_user_id_foreign")

  @@index([broker_id], map: "contracts_broker_id_foreign")
  @@index([customer_id], map: "contracts_customer_id_foreign")
  @@index([user_id], map: "contracts_user_id_foreign")
}

model coupons {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  code       String    @unique(map: "coupons_code_unique") @db.VarChar(255)
  discount   Decimal   @db.Decimal(8, 2)
  start_date DateTime? @db.Date
  end_date   DateTime? @db.Date
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model page_contents {
  id         Int       @id @default(autoincrement())
  section    String    @db.VarChar(100)
  key        String    @db.VarChar(100)
  value      String    @db.Text
  locale     String    @default("ar") @db.VarChar(10)
  is_active  Boolean   @default(true)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @updatedAt @db.Timestamp(0)

  @@unique([section, key, locale], map: "page_contents_section_key_locale_unique")
  @@index([section, locale], map: "page_contents_section_locale_index")
  @@index([is_active], map: "page_contents_is_active_index")
}

model news {
  id           Int       @id @default(autoincrement())
  title        String    @db.VarChar(255)
  slug         String    @unique(map: "news_slug_unique") @db.VarChar(255)
  excerpt      String?   @db.Text
  content      String    @db.LongText
  image_url    String?   @db.VarChar(500)
  is_active    Boolean   @default(true)
  published_at DateTime? @db.DateTime(0)
  created_at   DateTime? @default(now()) @db.Timestamp(0)
  updated_at   DateTime? @default(now()) @updatedAt @db.Timestamp(0)

  @@index([is_active, published_at], map: "news_is_active_published_at_index")
  @@index([published_at], map: "news_published_at_index")
}

model customer_offers {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customer_id BigInt    @db.UnsignedBigInt
  offer_id    BigInt    @db.UnsignedBigInt
  send_at     DateTime  @default(now()) @db.DateTime(0)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  customers   customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "customer_offers_customer_id_foreign")
  offers      offers    @relation(fields: [offer_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "customer_offers_offer_id_foreign")

  @@index([customer_id], map: "customer_offers_customer_id_foreign")
  @@index([offer_id], map: "customer_offers_offer_id_foreign")
}

model chat_conversations {
  id                 BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  customer_id        BigInt                   @db.UnsignedBigInt
  created_by_user_id BigInt?                  @db.UnsignedBigInt
  assigned_admin_id  BigInt?                  @db.UnsignedBigInt
  status             chat_conversation_status @default(open)
  last_message_at    DateTime?                @db.DateTime(0)
  created_at         DateTime                 @default(now()) @db.DateTime(0)
  updated_at         DateTime                 @updatedAt @db.DateTime(0)
  assigned_admin     users?                   @relation("chat_conversations_assigned_admin", fields: [assigned_admin_id], references: [id], onUpdate: Restrict, map: "chat_conversations_assigned_admin_id_foreign")
  created_by_user    users?                   @relation("chat_conversations_created_by_user", fields: [created_by_user_id], references: [id], onUpdate: Restrict, map: "chat_conversations_created_by_user_id_foreign")
  customer           customers                @relation("chat_conversations_customer", fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "chat_conversations_customer_id_foreign")
  messages           chat_messages[]

  @@index([customer_id, status], map: "chat_conversations_customer_id_status_index")
  @@index([created_by_user_id], map: "chat_conversations_created_by_user_id_foreign")
  @@index([assigned_admin_id], map: "chat_conversations_assigned_admin_id_foreign")
  @@index([last_message_at], map: "chat_conversations_last_message_at_index")
}

model chat_messages {
  id                 BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  conversation_id    BigInt                   @db.UnsignedBigInt
  sender_type        chat_message_sender_type
  sender_user_id     BigInt?                  @db.UnsignedBigInt
  sender_customer_id BigInt?                  @db.UnsignedBigInt
  content            String                   @db.LongText
  metadata           String?                  @db.LongText
  created_at         DateTime                 @default(now()) @db.DateTime(0)
  updated_at         DateTime                 @updatedAt @db.DateTime(0)
  conversation       chat_conversations       @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "chat_messages_conversation_id_foreign")
  sender_customer    customers?               @relation("chat_messages_sender_customer", fields: [sender_customer_id], references: [id], onUpdate: Restrict, map: "chat_messages_sender_customer_id_foreign")
  sender_user        users?                   @relation("chat_messages_sender_user", fields: [sender_user_id], references: [id], onUpdate: Restrict, map: "chat_messages_sender_user_id_foreign")

  @@index([conversation_id, created_at], map: "chat_messages_conversation_id_created_at_index")
  @@index([sender_user_id], map: "chat_messages_sender_user_id_foreign")
  @@index([sender_customer_id], map: "chat_messages_sender_customer_id_foreign")
}

model customers {
  id                                       BigInt                        @id @default(autoincrement()) @db.UnsignedBigInt
  full_name                                String                        @db.VarChar(255)
  company_name                             String?                       @db.VarChar(255)
  phone_number                             String?                       @db.VarChar(255)
  commercial_registration_number           String?                       @db.VarChar(255)
  remaining                                Float                         @default(0) @db.Float
  created_at                               DateTime?                     @db.Timestamp(0)
  updated_at                               DateTime?                     @db.Timestamp(0)
  address                                  String?                       @db.VarChar(255)
  type                                     Int                           @default(1) @db.UnsignedTinyInt
  work_type_id                             BigInt?                       @db.UnsignedBigInt
  alt_phone_number                         String?                       @db.Text
  belong_id                                BigInt?                       @db.UnsignedBigInt
  username                                 String?                       @db.VarChar(50)
  license_image                            String?                       @db.VarChar(255)
  email                                    String?                       @db.VarChar(255)
  password                                 String?                       @db.VarChar(255)
  fcm_token                                String?                       @db.VarChar(255)
  broker_id                                Int?
  status                                   String                        @default("0") @db.VarChar(255)
  added_by_manager                         Boolean                       @default(true)
  code                                     String?                       @db.VarChar(50)
  email_verified_at                        DateTime?                     @db.Date
  customer_account                         Decimal?                      @db.Decimal(10, 0)
  user_id                                  BigInt?                       @db.UnsignedBigInt
  best_customer_order                      Int                           @default(0)
  is_best_customer                         Boolean                       @default(false)
  accounts                                 accounts?
  balance_reconciliation_logs              balance_reconciliation_logs[]
  bookings                                 bookings[]
  chat_conversations                       chat_conversations[]          @relation("chat_conversations_customer")
  chat_messages                            chat_messages[]               @relation("chat_messages_sender_customer")
  contracts                                contracts[]
  customer_offers                          customer_offers[]
  customers                                customers?                    @relation("customersTocustomers", fields: [belong_id], references: [id], onUpdate: Restrict, map: "customers_belong_id_foreign")
  other_customers                          customers[]                   @relation("customersTocustomers")
  users                                    users?                        @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "customers_user_id_foreign")
  type_of_works                            type_of_works?                @relation(fields: [work_type_id], references: [id], onUpdate: Restrict, map: "customers_work_type_id_foreign")
  discounts                                discounts[]
  orders_orders_customer_idTocustomers     orders[]                      @relation("orders_customer_idTocustomers")
  orders_orders_customer_new_idTocustomers orders[]                      @relation("orders_customer_new_idTocustomers")
  payments                                 payments[]

  @@index([belong_id], map: "customers_belong_id_foreign")
  @@index([user_id], map: "customers_user_id_foreign")
  @@index([work_type_id], map: "customers_work_type_id_foreign")
  @@index([is_best_customer, best_customer_order], map: "customers_is_best_customer_best_customer_order_index")
}

model discounts {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id       BigInt    @db.UnsignedBigInt
  customer_id   BigInt    @db.UnsignedBigInt
  total         Decimal   @db.Decimal(10, 2)
  value         Decimal   @db.Decimal(10, 2)
  discount_type Int       @db.UnsignedTinyInt
  remaining     Decimal   @db.Decimal(10, 2)
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)
  customers     customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "discounts_customer_id_foreign")
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "discounts_user_id_foreign")

  @@index([customer_id], map: "discounts_customer_id_foreign")
  @@index([user_id], map: "discounts_user_id_foreign")
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String   @db.Text
  queue      String   @db.Text
  payload    String   @db.LongText
  exception  String   @db.LongText
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model favorites {
  id          BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  user_id     Int
  user_model  String     @db.VarChar(255)
  roadsign_id BigInt     @db.UnsignedBigInt
  created_at  DateTime?  @db.Timestamp(0)
  updated_at  DateTime?  @db.Timestamp(0)
  road_signs  road_signs @relation(fields: [roadsign_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "favorites_roadsign_id_foreign")

  @@index([roadsign_id], map: "favorites_roadsign_id_foreign")
}

model job_batches {
  id             String  @id @db.VarChar(255)
  name           String  @db.VarChar(255)
  total_jobs     Int
  pending_jobs   Int
  failed_jobs    Int
  failed_job_ids String  @db.LongText
  options        String? @db.MediumText
  cancelled_at   Int?
  created_at     Int
  finished_at    Int?
}

model jobs {
  id           BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  queue        String @db.VarChar(255)
  payload      String @db.LongText
  attempts     Int    @db.UnsignedTinyInt
  reserved_at  Int?   @db.UnsignedInt
  available_at Int    @db.UnsignedInt
  created_at   Int    @db.UnsignedInt

  @@index([queue], map: "jobs_queue_index")
