  updated_at             DateTime?        @db.Timestamp(0)
  users                  users?           @relation(fields: [created_by], references: [id], onUpdate: Restrict, map: "supplier_advances_created_by_foreign")
  journal_entries        journal_entries? @relation(fields: [given_journal_entry_id], references: [id], onUpdate: Restrict, map: "supplier_advances_given_journal_entry_id_foreign")
