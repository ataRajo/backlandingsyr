  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id        BigInt    @db.UnsignedBigInt
  amount         Decimal   @db.Decimal(12, 2)
  salary_type    String    @db.VarChar(20)
  effective_from DateTime  @db.Date
  is_active      Boolean   @default(true)
  notes          String?   @db.Text
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "employee_salaries_user_id_foreign")

  @@index([user_id, is_active], map: "employee_salaries_user_id_is_active_index")
}

model journal_entries {
  id                                                                                BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  entry_number                                                                      String                      @unique(map: "journal_entries_entry_number_unique") @db.VarChar(20)
  voucher_number                                                                    String?                     @unique(map: "journal_entries_voucher_number_unique") @db.VarChar(20)
  entry_date                                                                        DateTime                    @db.Date
  type                                                                              String                      @db.VarChar(20)
  description                                                                       String?                     @db.Text
  total_debit                                                                       Decimal                     @db.Decimal(14, 2)
  total_credit                                                                      Decimal                     @db.Decimal(14, 2)
  reference_type                                                                    String?                     @db.VarChar(255)
  reference_id                                                                      BigInt?                     @db.UnsignedBigInt
  created_by                                                                        BigInt?                     @db.UnsignedBigInt
  reversed_journal_entry_id                                                         BigInt?                     @db.UnsignedBigInt
  created_at                                                                        DateTime?                   @db.Timestamp(0)
  updated_at                                                                        DateTime?                   @db.Timestamp(0)
  bookings_bookings_broker_commission_journal_entry_idTojournal_entries             bookings[]                  @relation("bookings_broker_commission_journal_entry_idTojournal_entries")
  bookings_bookings_journal_entry_idTojournal_entries                               bookings[]                  @relation("bookings_journal_entry_idTojournal_entries")
  employee_advances                                                                 employee_advances[]
  users                                                                             users?                      @relation(fields: [created_by], references: [id], onUpdate: Restrict, map: "journal_entries_created_by_foreign")
  journal_entries                                                                   journal_entries?            @relation("journal_entriesTojournal_entries", fields: [reversed_journal_entry_id], references: [id], onUpdate: Restrict, map: "journal_entries_reversed_journal_entry_id_foreign")
  other_journal_entries                                                             journal_entries[]           @relation("journal_entriesTojournal_entries")
  journal_entry_details                                                             journal_entry_details[]
  orders                                                                            orders[]
  payments                                                                          payments[]
  payroll_adjustments                                                               payroll_adjustments[]
  purchase_invoice_payments                                                         purchase_invoice_payments[]
  purchase_invoices_purchase_invoices_payment_journal_entry_idTojournal_entries     purchase_invoices[]         @relation("purchase_invoices_payment_journal_entry_idTojournal_entries")
  purchase_invoices_purchase_invoices_recognition_journal_entry_idTojournal_entries purchase_invoices[]         @relation("purchase_invoices_recognition_journal_entry_idTojournal_entries")
  supplier_advances                                                                 supplier_advances[]

  @@index([created_by], map: "journal_entries_created_by_foreign")
  @@index([entry_date], map: "journal_entries_entry_date_index")
  @@index([reference_type, reference_id], map: "journal_entries_reference_type_reference_id_index")
  @@index([reversed_journal_entry_id], map: "journal_entries_reversed_journal_entry_id_foreign")
  @@index([type], map: "journal_entries_type_index")
}

model journal_entry_details {
  id               BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  journal_entry_id BigInt          @db.UnsignedBigInt
  account_id       BigInt          @db.UnsignedBigInt
  debit            Decimal         @default(0.00) @db.Decimal(14, 2)
  credit           Decimal         @default(0.00) @db.Decimal(14, 2)
  currency         String          @default("USD") @db.VarChar(3)
  exchange_rate    Decimal         @default(1.000000) @db.Decimal(14, 6)
  debit_base       Decimal         @default(0.00) @db.Decimal(14, 2)
  credit_base      Decimal         @default(0.00) @db.Decimal(14, 2)
  balance_after    Decimal         @db.Decimal(14, 2)
  created_at       DateTime?       @db.Timestamp(0)
  updated_at       DateTime?       @db.Timestamp(0)
  accounts         accounts        @relation(fields: [account_id], references: [id], onUpdate: Restrict, map: "journal_entry_details_account_id_foreign")
  journal_entries  journal_entries @relation(fields: [journal_entry_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "journal_entry_details_journal_entry_id_foreign")

  @@index([account_id], map: "journal_entry_details_account_id_index")
  @@index([journal_entry_id], map: "journal_entry_details_journal_entry_id_foreign")
}

model materials {
